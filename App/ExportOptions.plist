<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- TestFlight and the App Store share one export method. -->
	<key>method</key>
	<string>app-store-connect</string>
	<key>teamID</key>
	<string>7VB9A7H26M</string>
	<!-- Let Xcode create/renew the distribution profile as needed; pair with
	     -allowProvisioningUpdates on the xcodebuild call. -->
	<key>signingStyle</key>
	<string>automatic</string>
	<!-- Symbols are what turn TestFlight crash reports into readable stacks. -->
	<key>uploadSymbols</key>
	<true/>
	<key>destination</key>
	<string>export</string>
</dict>
</plist>
